# FFCS / Curriculum backend configuration
# Copy these keys into backend/.env (never commit real secrets)

# Gemini (server-side only; never expose to frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_TIMEOUT_MS=90000

# Admin protection for POST /api/admin/curriculum/upload
# Comma separated Firebase account emails
ADMIN_EMAILS=
# Optional server-to-server key sent as the x-admin-key header
ADMIN_API_KEY=

# Defaults for curriculum ingestion
DEFAULT_INSTITUTION=VIT
DEFAULT_ACADEMIC_YEAR=2026-27

# Upload + concurrency tuning
FFCS_UPLOAD_DIR=
FFCS_MAX_IMAGE_BYTES=8388608
FFCS_MAX_PDF_BYTES=26214400
FFCS_LOCK_TTL_MS=120000
FFCS_WAIT_TIMEOUT_MS=60000
FFCS_WAIT_INTERVAL_MS=1500
FFCS_MAX_EXTRACTION_ATTEMPTS=2
