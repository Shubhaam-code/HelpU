{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/oauth-callback",
      "destination": "/oauth-callback.html"
    },
    {
      "source": "/oauth-callback/(.*)",
      "destination": "/oauth-callback.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
