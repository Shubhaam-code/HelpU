{
  "appId": "com.helpu.app",
  "appName": "Helpu",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": false,
    "allowNavigation": [
      "*.clerk.accounts.dev",
      "clerk.accounts.dev",
      "*.accounts.dev",
      "accounts.dev",
      "*.clerk.com",
      "clerk.com",
      "challenges.cloudflare.com",
      "*.cloudflare.com"
    ]
  },
  "plugins": {
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#FFF8F3"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    },
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#FFF8F3",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}

